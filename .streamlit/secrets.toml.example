# Copy this file to .streamlit/secrets.toml and fill in your own values.
# secrets.toml is git-ignored — never commit a real key.

# Free key from https://site.financialmodelingprep.com/developer/docs
# Optional: without it the app falls back to yfinance.
FMP_API_KEY = "your-fmp-api-key-here"

# Optional: SEC asks automated clients to identify themselves with a contact.
SEC_USER_AGENT = "Your Name your.email@example.com"
